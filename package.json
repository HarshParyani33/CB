{
  "name": "bunny-demo",
  "version": "1.0.0",
  "description": "Demo AI shopping assistant for SPOILED BUNNY",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "sync-catalog": "node server/scripts/syncCatalog.js",
    "test:tools": "node server/scripts/testToolsCli.js",
    "test:chat": "node server/scripts/runTests.js",
    "test": "node server/scripts/testToolsCli.js",
    "build:widget": "npm --prefix widget install && npm --prefix widget run build",
    "build": "node -e \"console.log('Prebuilt widget bundle is ready in /dist')\"",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^4.85.4"
  },
  "keywords": ["ai", "shopping-assistant", "shopify", "spoiledbunny"],
  "author": "",
  "license": "ISC"
}
